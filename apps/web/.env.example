# Copy to apps/web/.env (gitignored) and fill in your Supabase project's values.
# Never commit real credentials.

# ========================================
# SUPABASE
# ========================================

# Public — safe to expose to the browser.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Server-only. Bypasses RLS — never expose to the client. Used only for
# provisioning writes in server/domains/identity (see AuthService).
NUXT_SUPABASE_SECRET_KEY=your-service-role-key

# Origin used for links inside emails (the account-confirmation link).
# OPTIONAL — normally detected automatically: a Vercel deployment reports its
# own URL and anything else falls back to http://localhost:3000, so local dev
# and the deployment can share one Supabase project without their confirmation
# emails pointing at each other. See server/utils/site-url.ts. Set this only to
# force a value, e.g. on a host that is neither Vercel nor local.
# NUXT_SITE_URL=https://your-domain.com

# ========================================
# STRIPE (International Cards)
# ========================================

# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get from https://dashboard.stripe.com/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ========================================
# PAYMONGO (Philippine Payments: GCash, GrabPay, Cards)
# ========================================

# Get from https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...

# Get from PayMongo webhook settings
PAYMONGO_WEBHOOK_SECRET=whsec_...

# ========================================
# CLOUDFLARE TURNSTILE (Bot protection on register/login)
# ========================================

# Get from https://dash.cloudflare.com -> Turnstile -> Add site (free tier).
# See docs/31-THIRD-PARTY-SETUP.md for full setup steps.
#
# REQUIRED outside local dev. If TURNSTILE_SECRET_KEY is unset, `nuxt dev` logs
# a loud warning and skips the check so local work isn't blocked — but any
# production build REJECTS login and registration with a 500 rather than
# running them unprotected. Set this before deploying.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
