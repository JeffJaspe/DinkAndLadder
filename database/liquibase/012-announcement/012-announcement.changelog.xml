<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════════
         012-announcement: Club Announcements Domain
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- 0001: club_announcements table -->
    <changeSet id="0001-club-announcements-table" author="announcement-domain">
        <createTable tableName="club_announcements">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="club_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_announcement_club"
                             references="clubs(id)"/>
            </column>
            <column name="author_player_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_announcement_author"
                             references="player_profiles(id)"/>
            </column>
            <column name="title" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="announcement_type" type="varchar(20)" defaultValue="general">
                <constraints nullable="false"/>
            </column>
            <column name="visibility" type="varchar(20)" defaultValue="all_members">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="draft">
                <constraints nullable="false"/>
            </column>
            <column name="event_id" type="uuid">
                <constraints nullable="true"
                             foreignKeyName="fk_announcement_event"
                             references="events(id)"/>
            </column>
            <column name="pinned" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="archived_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE club_announcements
            ADD CONSTRAINT chk_announcement_type CHECK (announcement_type IN ('general', 'event', 'maintenance', 'urgent'));
            ALTER TABLE club_announcements
            ADD CONSTRAINT chk_announcement_visibility CHECK (visibility IN ('all_members', 'active_members', 'admins_only'));
            ALTER TABLE club_announcements
            ADD CONSTRAINT chk_announcement_status CHECK (status IN ('draft', 'published', 'archived'));
        </sql>
    </changeSet>

    <!-- 0002: club_announcement_reads table -->
    <changeSet id="0002-announcement-reads-table" author="announcement-domain">
        <createTable tableName="club_announcement_reads">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="announcement_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_announcement_read_announcement"
                             references="club_announcements(id)"/>
            </column>
            <column name="player_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_announcement_read_player"
                             references="player_profiles(id)"/>
            </column>
            <column name="read_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="club_announcement_reads"
            columnNames="announcement_id,player_id"
            constraintName="uq_announcement_read"/>
    </changeSet>

    <!-- 0003: indexes -->
    <changeSet id="0003-announcement-indexes" author="announcement-domain">
        <createIndex tableName="club_announcements" indexName="idx_announcements_club">
            <column name="club_id"/>
        </createIndex>
        <createIndex tableName="club_announcements" indexName="idx_announcements_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="club_announcements" indexName="idx_announcements_published">
            <column name="published_at" descending="true"/>
        </createIndex>
        <createIndex tableName="club_announcements" indexName="idx_announcements_pinned">
            <column name="pinned"/>
        </createIndex>
        <createIndex tableName="club_announcement_reads" indexName="idx_announcement_reads_player">
            <column name="player_id"/>
        </createIndex>
    </changeSet>

    <!-- 0004: RLS -->
    <changeSet id="0004-announcement-enable-rls" author="announcement-domain">
        <sql>
            ALTER TABLE club_announcements ENABLE ROW LEVEL SECURITY;
            ALTER TABLE club_announcement_reads ENABLE ROW LEVEL SECURITY;
        </sql>
        <rollback>
            ALTER TABLE club_announcements DISABLE ROW LEVEL SECURITY;
            ALTER TABLE club_announcement_reads DISABLE ROW LEVEL SECURITY;
        </rollback>
    </changeSet>

    <changeSet id="0005-announcement-policies" author="announcement-domain">
        <sql>
            CREATE POLICY announcements_select_member ON club_announcements
                FOR SELECT
                USING (
                    status = 'published'
                    AND fn_is_active_club_member(club_id)
                );

            CREATE POLICY announcements_select_own ON club_announcements
                FOR SELECT
                USING (
                    author_player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                );

            CREATE POLICY announcement_reads_manage_own ON club_announcement_reads
                FOR ALL
                USING (
                    player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                )
                WITH CHECK (
                    player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                );
        </sql>
        <rollback>
            DROP POLICY IF EXISTS announcements_select_member ON club_announcements;
            DROP POLICY IF EXISTS announcements_select_own ON club_announcements;
            DROP POLICY IF EXISTS announcement_reads_manage_own ON club_announcement_reads;
        </rollback>
    </changeSet>

</databaseChangeLog>
