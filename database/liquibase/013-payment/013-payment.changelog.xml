  <!-- RLS — relocated from 008-security.changelog.xml (was 0032-0037 there): the master
       changelog includes 008-security before this file, so those policies were trying to
       ALTER/CREATE POLICY on tables this file hadn't created yet. Never applied under the old
       location, so moving them here is safe. -->
  <changeSet id="0007-payment-enable-rls" author="payment-domain">
    <sql>
      ALTER TABLE subscription_plans ENABLE ROW LEVEL SECURITY;
      ALTER TABLE player_subscriptions ENABLE ROW LEVEL SECURITY;
      ALTER TABLE club_subscriptions ENABLE ROW LEVEL SECURITY;
      ALTER TABLE payment_transactions ENABLE ROW LEVEL SECURITY;
      ALTER TABLE sponsorships ENABLE ROW LEVEL SECURITY;
    </sql>
    <rollback>
      ALTER TABLE subscription_plans DISABLE ROW LEVEL SECURITY;
      ALTER TABLE player_subscriptions DISABLE ROW LEVEL SECURITY;
      ALTER TABLE club_subscriptions DISABLE ROW LEVEL SECURITY;
      ALTER TABLE payment_transactions DISABLE ROW LEVEL SECURITY;
      ALTER TABLE sponsorships DISABLE ROW LEVEL SECURITY;
    </rollback>
  </changeSet>

  <changeSet id="0008-subscription-plans-policies" author="payment-domain">
    <sql>
      CREATE POLICY subscription_plans_select_active ON subscription_plans
          FOR SELECT
          USING (is_active = true);
    </sql>
    <rollback>
      DROP POLICY IF EXISTS subscription_plans_select_active ON subscription_plans;
    </rollback>
  </changeSet>

  <changeSet id="0009-player-subscriptions-policies" author="payment-domain">
    <sql>
      CREATE POLICY player_subscriptions_select_own ON player_subscriptions
          FOR SELECT
          USING (
              player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
          );
    </sql>
    <rollback>
      DROP POLICY IF EXISTS player_subscriptions_select_own ON player_subscriptions;
    </rollback>
  </changeSet>

  <changeSet id="0010-club-subscriptions-policies" author="payment-domain">
    <sql>
      CREATE POLICY club_subscriptions_select_own ON club_subscriptions
          FOR SELECT
          USING (
              club_id IN (
                  SELECT cm.club_id FROM club_memberships cm
                  JOIN player_profiles pp ON cm.player_id = pp.id
                  WHERE pp.user_id = auth.uid()
                  AND cm.status = 'active'
                  AND cm.role IN ('OWNER', 'ADMIN')
              )
          );
    </sql>
    <rollback>
      DROP POLICY IF EXISTS club_subscriptions_select_own ON club_subscriptions;
    </rollback>
  </changeSet>

  <changeSet id="0011-payment-transactions-policies" author="payment-domain">
    <sql>
      CREATE POLICY payment_transactions_select_own ON payment_transactions
          FOR SELECT
          USING (
              player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
              OR club_id IN (
                  SELECT cm.club_id FROM club_memberships cm
                  JOIN player_profiles pp ON cm.player_id = pp.id
                  WHERE pp.user_id = auth.uid()
                  AND cm.status = 'active'
                  AND cm.role IN ('OWNER', 'ADMIN')
              )
          );
    </sql>
    <rollback>
      DROP POLICY IF EXISTS payment_transactions_select_own ON payment_transactions;
    </rollback>
  </changeSet>

  <changeSet id="0012-sponsorships-policies" author="payment-domain">
    <sql>
      CREATE POLICY sponsorships_select_involved ON sponsorships
          FOR SELECT
          USING (
              sponsor_player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
              OR (
                  target_type = 'player'
                  AND target_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                  AND status = 'completed'
              )
          );
    </sql>
    <rollback>
      DROP POLICY IF EXISTS sponsorships_select_involved ON sponsorships;
    </rollback>
  </changeSet>

</databaseChangeLog>
