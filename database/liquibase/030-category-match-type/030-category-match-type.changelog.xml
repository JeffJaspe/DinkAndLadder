<?xml version="1.0" encoding="UTF-8"?>
<!-- Singles or doubles, per category.

     `match_type` lived only on `tournaments` (006-event, changeSet 0003), so
     every category of a tournament had to be the same. That is wrong for the
     ordinary case: "Men's Doubles 4.0" and "Singles Open" are two categories of
     one weekend, not two tournaments, and the redesign that put categories
     directly under the event made the single shared value visible as a gap —
     nothing on a category said which it was, because there was nothing to say.

     Nullable, meaning "inherit from the tournament". Existing rows are
     backfilled from their tournament in changeSet 0003 so nothing reads as
     unknown, but the column stays nullable rather than being forced NOT NULL:
     a category created by an older client still resolves to something sensible
     instead of failing an insert, and the application resolves
     `category.match_type ?? tournament.match_type` in one helper.

     `tournaments.match_type` is deliberately left in place and still NOT NULL.
     It is the default a new category inherits and the fallback for the
     category-less path, and dropping it would be a destructive change to a
     column three services still read.

     No RLS change: tournament_categories policies (018-platform-enhancements)
     are row-level and column-agnostic, so a new column inherits them. -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0001-add-category-match-type" author="category-match-type">
        <addColumn tableName="tournament_categories">
            <column name="match_type" type="text"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="tournament_categories" columnName="match_type"/>
        </rollback>
    </changeSet>

    <!-- Split from the addColumn to match the convention every other changelog
         here uses for constraints. -->
    <changeSet id="0002-category-match-type-check" author="category-match-type">
        <sql>
            ALTER TABLE tournament_categories
                ADD CONSTRAINT ck_tournament_categories_match_type
                CHECK (match_type IS NULL OR match_type IN ('singles', 'doubles'));
        </sql>
        <rollback>
            ALTER TABLE tournament_categories
                DROP CONSTRAINT ck_tournament_categories_match_type;
        </rollback>
    </changeSet>

    <!-- Backfill so every category that already exists states its own type
         rather than relying on the fallback. Forward-only: the rollback leaves
         the values alone, because dropping the column (0001) removes them
         anyway and there is no prior state to restore them to. -->
    <changeSet id="0003-backfill-category-match-type" author="category-match-type">
        <sql>
            UPDATE tournament_categories c
            SET match_type = t.match_type
            FROM tournaments t
            WHERE c.tournament_id = t.id
              AND c.match_type IS NULL;
        </sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
