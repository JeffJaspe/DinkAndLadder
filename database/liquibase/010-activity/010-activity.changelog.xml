<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════════
         010-activity: Activity Feed Domain
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- 0001: activities table -->
    <changeSet id="0001-activities-table" author="activity-domain">
        <createTable tableName="activities">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="actor_player_id" type="uuid">
                <constraints nullable="true"
                             foreignKeyName="fk_activity_actor_player"
                             references="player_profiles(id)"/>
            </column>
            <column name="actor_club_id" type="uuid">
                <constraints nullable="true"
                             foreignKeyName="fk_activity_actor_club"
                             references="clubs(id)"/>
            </column>
            <column name="activity_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_type" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="reference_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="visibility" type="varchar(20)" defaultValue="public">
                <constraints nullable="false"/>
            </column>
            <column name="metadata" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE activities
            ADD CONSTRAINT chk_activity_visibility CHECK (visibility IN ('public', 'followers', 'club', 'private'));
        </sql>
    </changeSet>

    <!-- 0002: activities indexes -->
    <changeSet id="0002-activities-indexes" author="activity-domain">
        <createIndex tableName="activities" indexName="idx_activities_actor_player">
            <column name="actor_player_id"/>
        </createIndex>
        <createIndex tableName="activities" indexName="idx_activities_actor_club">
            <column name="actor_club_id"/>
        </createIndex>
        <createIndex tableName="activities" indexName="idx_activities_type">
            <column name="activity_type"/>
        </createIndex>
        <createIndex tableName="activities" indexName="idx_activities_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
        <createIndex tableName="activities" indexName="idx_activities_reference">
            <column name="reference_type"/>
            <column name="reference_id"/>
        </createIndex>
    </changeSet>

    <!-- 0003: RLS for activities -->
    <changeSet id="0003-activities-enable-rls" author="activity-domain">
        <sql>ALTER TABLE activities ENABLE ROW LEVEL SECURITY;</sql>
        <rollback>ALTER TABLE activities DISABLE ROW LEVEL SECURITY;</rollback>
    </changeSet>

    <changeSet id="0004-activities-policies" author="activity-domain">
        <sql>
            CREATE POLICY activities_select_public ON activities
                FOR SELECT
                USING (visibility = 'public');

            CREATE POLICY activities_select_own ON activities
                FOR SELECT
                USING (
                    actor_player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                );
        </sql>
        <rollback>
            DROP POLICY IF EXISTS activities_select_public ON activities;
            DROP POLICY IF EXISTS activities_select_own ON activities;
        </rollback>
    </changeSet>

</databaseChangeLog>
