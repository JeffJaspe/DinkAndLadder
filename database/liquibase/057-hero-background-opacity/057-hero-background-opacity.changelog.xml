<?xml version="1.0" encoding="UTF-8"?>
<!-- Operator control over how strongly the landing background image reads
     (docs/30-SUPER-ADMIN-SPECIFICATION.md §2.3).

     026 gave the SuperAdmin a hero image and a scrim colour/strength for the
     text on top of it. What it did not give was any control over the image
     itself: the landing page lays a flat wash of the theme's own canvas over
     the artwork at a hardcoded 0.92, so an uploaded background always came out
     as a barely-visible ghost and the console offered no way to change that.

     This column is that wash, expressed the way an operator thinks about it -
     how visible the image is, 0.0 (invisible) to 1.0 (untouched). NULL keeps
     the value the page has always painted, so nothing moves until it is set. -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0001-add-hero-background-opacity" author="super-admin">
        <addColumn tableName="platform_config">
            <!-- Nullable for the reason 026 gives for its own hero columns:
                 NULL means "never set", which is distinguishable from an
                 operator deliberately choosing the same value the page
                 already uses. numeric(3,2) matches hero_overlay_opacity, so
                 0.35 stores as 0.35 rather than as a float approximation. -->
            <column name="hero_background_opacity" type="numeric(3,2)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="platform_config" columnName="hero_background_opacity"/>
        </rollback>
    </changeSet>

    <changeSet id="0002-check-hero-background-opacity" author="super-admin">
        <!-- The value reaches a public page as an inline style. The service
             validates it too; this is the guard that survives a future write
             path that forgets to. -->
        <sql>
            ALTER TABLE platform_config ADD CONSTRAINT ck_platform_config_hero_background_opacity
                CHECK (hero_background_opacity IS NULL
                       OR (hero_background_opacity >= 0 AND hero_background_opacity &lt;= 1));
        </sql>
        <rollback>
            ALTER TABLE platform_config DROP CONSTRAINT ck_platform_config_hero_background_opacity;
        </rollback>
    </changeSet>

</databaseChangeLog>
