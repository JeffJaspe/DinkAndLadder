<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <!-- Regions reference table -->
  <changeSet id="0001" author="claude">
    <createTable tableName="regions">
      <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="code" type="varchar(10)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="name" type="varchar(100)">
        <constraints nullable="false"/>
      </column>
      <column name="sort_order" type="integer" defaultValue="0"/>
      <column name="created_at" type="timestamptz" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <!-- Provinces reference table -->
  <changeSet id="0002" author="claude">
    <createTable tableName="provinces">
      <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="region_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="varchar(100)">
        <constraints nullable="false"/>
      </column>
      <column name="sort_order" type="integer" defaultValue="0"/>
      <column name="created_at" type="timestamptz" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint
      baseTableName="provinces"
      baseColumnNames="region_id"
      constraintName="fk_provinces_region"
      referencedTableName="regions"
      referencedColumnNames="id"/>
    <createIndex tableName="provinces" indexName="idx_provinces_region">
      <column name="region_id"/>
    </createIndex>
  </changeSet>

  <!-- Seed Philippine regions -->
  <changeSet id="0003" author="claude">
    <insert tableName="regions"><column name="code" value="NCR"/><column name="name" value="National Capital Region"/><column name="sort_order" value="1"/></insert>
    <insert tableName="regions"><column name="code" value="CAR"/><column name="name" value="Cordillera Administrative Region"/><column name="sort_order" value="2"/></insert>
    <insert tableName="regions"><column name="code" value="I"/><column name="name" value="Ilocos Region"/><column name="sort_order" value="3"/></insert>
    <insert tableName="regions"><column name="code" value="II"/><column name="name" value="Cagayan Valley"/><column name="sort_order" value="4"/></insert>
    <insert tableName="regions"><column name="code" value="III"/><column name="name" value="Central Luzon"/><column name="sort_order" value="5"/></insert>
    <insert tableName="regions"><column name="code" value="IV-A"/><column name="name" value="CALABARZON"/><column name="sort_order" value="6"/></insert>
    <insert tableName="regions"><column name="code" value="IV-B"/><column name="name" value="MIMAROPA"/><column name="sort_order" value="7"/></insert>
    <insert tableName="regions"><column name="code" value="V"/><column name="name" value="Bicol Region"/><column name="sort_order" value="8"/></insert>
    <insert tableName="regions"><column name="code" value="VI"/><column name="name" value="Western Visayas"/><column name="sort_order" value="9"/></insert>
    <insert tableName="regions"><column name="code" value="VII"/><column name="name" value="Central Visayas"/><column name="sort_order" value="10"/></insert>
    <insert tableName="regions"><column name="code" value="VIII"/><column name="name" value="Eastern Visayas"/><column name="sort_order" value="11"/></insert>
    <insert tableName="regions"><column name="code" value="IX"/><column name="name" value="Zamboanga Peninsula"/><column name="sort_order" value="12"/></insert>
    <insert tableName="regions"><column name="code" value="X"/><column name="name" value="Northern Mindanao"/><column name="sort_order" value="13"/></insert>
    <insert tableName="regions"><column name="code" value="XI"/><column name="name" value="Davao Region"/><column name="sort_order" value="14"/></insert>
    <insert tableName="regions"><column name="code" value="XII"/><column name="name" value="SOCCSKSARGEN"/><column name="sort_order" value="15"/></insert>
    <insert tableName="regions"><column name="code" value="XIII"/><column name="name" value="Caraga"/><column name="sort_order" value="16"/></insert>
    <insert tableName="regions"><column name="code" value="BARMM"/><column name="name" value="Bangsamoro"/><column name="sort_order" value="17"/></insert>
  </changeSet>

  <!-- Seed NCR cities/municipalities as provinces for now -->
  <changeSet id="0004" author="claude">
    <sql>
      INSERT INTO provinces (region_id, name, sort_order)
      SELECT r.id, p.name, p.sort_order
      FROM regions r, (VALUES
        ('Metro Manila', 1),
        ('Makati', 2),
        ('Taguig', 3),
        ('Pasig', 4),
        ('Quezon City', 5),
        ('Manila', 6),
        ('Mandaluyong', 7),
        ('San Juan', 8),
        ('Pasay', 9),
        ('Paranaque', 10),
        ('Las Pinas', 11),
        ('Muntinlupa', 12),
        ('Marikina', 13),
        ('Caloocan', 14),
        ('Malabon', 15),
        ('Navotas', 16),
        ('Valenzuela', 17)
      ) AS p(name, sort_order)
      WHERE r.code = 'NCR';
    </sql>
  </changeSet>

  <!-- RLS for regions/provinces (public read) -->
  <changeSet id="0005" author="claude">
    <sql>
      ALTER TABLE regions ENABLE ROW LEVEL SECURITY;
      ALTER TABLE provinces ENABLE ROW LEVEL SECURITY;

      CREATE POLICY regions_select_all ON regions FOR SELECT USING (true);
      CREATE POLICY provinces_select_all ON provinces FOR SELECT USING (true);
    </sql>
    <rollback>
      DROP POLICY IF EXISTS regions_select_all ON regions;
      DROP POLICY IF EXISTS provinces_select_all ON provinces;
      ALTER TABLE regions DISABLE ROW LEVEL SECURITY;
      ALTER TABLE provinces DISABLE ROW LEVEL SECURITY;
    </rollback>
  </changeSet>

</databaseChangeLog>
