<?xml version="1.0" encoding="UTF-8"?>
<!-- Partnership domain: partnerships (mutual relationships) and partner_requests (request flow).
     Replaces follower/following with a mutual partner system for doubles play. -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Partnerships table: confirmed mutual partnerships between players -->
    <changeSet id="0001-create-partnerships-table" author="partnership-domain">
        <createTable tableName="partnerships">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player1_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_partnerships_player1" references="player_profiles(id)"/>
            </column>
            <column name="player2_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_partnerships_player2" references="player_profiles(id)"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0002-partnerships-constraints" author="partnership-domain">
        <sql splitStatements="false">
            -- Ensure player1_id is always less than player2_id to prevent duplicate pairs
            ALTER TABLE partnerships ADD CONSTRAINT chk_partnerships_order
                CHECK (player1_id &lt; player2_id);
            -- Unique constraint on the pair
            ALTER TABLE partnerships ADD CONSTRAINT uq_partnerships_players
                UNIQUE (player1_id, player2_id);
            -- No self-partnership
            ALTER TABLE partnerships ADD CONSTRAINT chk_no_self_partnership
                CHECK (player1_id != player2_id);
        </sql>
    </changeSet>

    <changeSet id="0003-partnerships-indexes" author="partnership-domain">
        <createIndex tableName="partnerships" indexName="idx_partnerships_player1">
            <column name="player1_id"/>
        </createIndex>
        <createIndex tableName="partnerships" indexName="idx_partnerships_player2">
            <column name="player2_id"/>
        </createIndex>
    </changeSet>

    <!-- Partner requests table: request/accept/decline flow -->
    <changeSet id="0004-create-partner-requests-table" author="partnership-domain">
        <createTable tableName="partner_requests">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_player_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_partner_requests_from" references="player_profiles(id)"/>
            </column>
            <column name="to_player_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_partner_requests_to" references="player_profiles(id)"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="pending">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="responded_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0005-partner-requests-constraints" author="partnership-domain">
        <sql splitStatements="false">
            ALTER TABLE partner_requests ADD CONSTRAINT chk_partner_request_status
                CHECK (status IN ('pending', 'accepted', 'declined', 'cancelled'));
            ALTER TABLE partner_requests ADD CONSTRAINT chk_no_self_request
                CHECK (from_player_id != to_player_id);
        </sql>
    </changeSet>

    <changeSet id="0006-partner-requests-indexes" author="partnership-domain">
        <createIndex tableName="partner_requests" indexName="idx_partner_requests_from">
            <column name="from_player_id"/>
        </createIndex>
        <createIndex tableName="partner_requests" indexName="idx_partner_requests_to">
            <column name="to_player_id"/>
        </createIndex>
        <createIndex tableName="partner_requests" indexName="idx_partner_requests_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- RLS policies -->
    <changeSet id="0007-partnerships-rls" author="partnership-domain">
        <sql splitStatements="false">
            ALTER TABLE partnerships ENABLE ROW LEVEL SECURITY;

            -- Partnerships visible to either partner
            CREATE POLICY partnerships_select_own ON partnerships
                FOR SELECT
                USING (
                    player1_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                    OR player2_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                );
        </sql>
    </changeSet>

    <changeSet id="0008-partner-requests-rls" author="partnership-domain">
        <sql splitStatements="false">
            ALTER TABLE partner_requests ENABLE ROW LEVEL SECURITY;

            -- Partner requests visible to sender and recipient
            CREATE POLICY partner_requests_select_own ON partner_requests
                FOR SELECT
                USING (
                    from_player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                    OR to_player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                );
        </sql>
    </changeSet>

</databaseChangeLog>
