<?xml version="1.0" encoding="UTF-8"?>
<!-- Platform enhancement plan: club verification (SuperAdmin-managed), tournament
     categories (predefined + custom), and the minimal platform_config table needed to
     gate SuperAdmin-only actions. Account switching (Player/Club mode) itself needs no
     schema — it's a UI-only concept; see apps/web/composables/useAccountMode.ts. RLS lives
     in this same file, not 008-security, per the established convention (008-security is
     included before this file in the master changelog, so any policy here referencing a
     table this file just created is safe; a policy placed in 008-security instead would
     reference a not-yet-existing table). -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Club verification -->
    <changeSet id="0001-add-club-verification-columns" author="platform-enhancements">
        <addColumn tableName="clubs">
            <column name="verification_status" type="text" defaultValue="unverified">
                <constraints nullable="false"/>
            </column>
            <column name="verification_requested_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="verified_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="verified_by_user_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_clubs_verified_by" references="users(id)"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE clubs ADD CONSTRAINT ck_clubs_verification_status
                CHECK (verification_status IN ('unverified', 'pending', 'verified', 'suspended', 'revoked'));
        </sql>
        <rollback>
            ALTER TABLE clubs DROP CONSTRAINT ck_clubs_verification_status;
            <dropColumn tableName="clubs" columnName="verification_status"/>
            <dropColumn tableName="clubs" columnName="verification_requested_at"/>
            <dropColumn tableName="clubs" columnName="verified_at"/>
            <dropColumn tableName="clubs" columnName="verified_by_user_id"/>
        </rollback>
    </changeSet>

    <changeSet id="0002-clubs-verification-index" author="platform-enhancements">
        <createIndex tableName="clubs" indexName="idx_clubs_verification_status">
            <column name="verification_status"/>
        </createIndex>
    </changeSet>

    <!-- Minimal platform_config: just enough to gate SuperAdmin-only actions (club
         verification approval) for this pass. docs/30-SUPER-ADMIN-SPECIFICATION.md
         describes a much larger branding/theming/feature-flag system built on the same
         table name — deliberately not built here; that's a separate, later backlog item.
         Single-row table; super_admin_id starts NULL and must be set manually (direct SQL)
         by whoever operates the deployment once they know the real admin's user id. -->
    <changeSet id="0003-create-platform-config-table" author="platform-enhancements">
        <createTable tableName="platform_config">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="super_admin_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_platform_config_super_admin" references="users(id)"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0004-seed-platform-config-row" author="platform-enhancements">
        <insert tableName="platform_config">
            <column name="super_admin_id" valueComputed="NULL"/>
        </insert>
        <rollback>
            <delete tableName="platform_config"/>
        </rollback>
    </changeSet>

    <!-- Tournament category templates: predefined rating-band presets an organizer can
         reuse instead of typing custom ranges each time. Reference data, seeded here. -->
    <changeSet id="0005-create-tournament-category-templates" author="platform-enhancements">
        <createTable tableName="tournament_category_templates">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_tournament_category_templates_name"/>
            </column>
            <column name="min_rating" type="numeric">
                <constraints nullable="true"/>
            </column>
            <column name="max_rating" type="numeric">
                <constraints nullable="true"/>
            </column>
            <column name="display_order" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0006-seed-tournament-category-templates" author="platform-enhancements">
        <insert tableName="tournament_category_templates">
            <column name="name" value="Novice"/>
            <column name="min_rating" valueComputed="NULL"/>
            <column name="max_rating" valueNumeric="2.5"/>
            <column name="display_order" valueNumeric="1"/>
        </insert>
        <insert tableName="tournament_category_templates">
            <column name="name" value="Beginner"/>
            <column name="min_rating" valueNumeric="2.5"/>
            <column name="max_rating" valueNumeric="3.0"/>
            <column name="display_order" valueNumeric="2"/>
        </insert>
        <insert tableName="tournament_category_templates">
            <column name="name" value="Intermediate"/>
            <column name="min_rating" valueNumeric="3.0"/>
            <column name="max_rating" valueNumeric="3.5"/>
            <column name="display_order" valueNumeric="3"/>
        </insert>
        <insert tableName="tournament_category_templates">
            <column name="name" value="Advanced"/>
            <column name="min_rating" valueNumeric="3.5"/>
            <column name="max_rating" valueNumeric="4.5"/>
            <column name="display_order" valueNumeric="4"/>
        </insert>
        <insert tableName="tournament_category_templates">
            <column name="name" value="Expert"/>
            <column name="min_rating" valueNumeric="4.5"/>
            <column name="max_rating" valueNumeric="5.5"/>
            <column name="display_order" valueNumeric="5"/>
        </insert>
        <insert tableName="tournament_category_templates">
            <column name="name" value="Pro"/>
            <column name="min_rating" valueNumeric="5.5"/>
            <column name="max_rating" valueComputed="NULL"/>
            <column name="display_order" valueNumeric="6"/>
        </insert>
        <insert tableName="tournament_category_templates">
            <column name="name" value="Open"/>
            <column name="min_rating" valueComputed="NULL"/>
            <column name="max_rating" valueComputed="NULL"/>
            <column name="display_order" valueNumeric="7"/>
        </insert>
        <rollback>
            <delete tableName="tournament_category_templates"/>
        </rollback>
    </changeSet>

    <!-- Tournament categories: per-tournament category instances, either copied from a
         template or fully custom. -->
    <changeSet id="0007-create-tournament-categories" author="platform-enhancements">
        <createTable tableName="tournament_categories">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tournament_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_tournament_categories_tournament" references="tournaments(id)"/>
            </column>
            <column name="template_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_tournament_categories_template" references="tournament_category_templates(id)"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="category_type" type="text" defaultValue="custom">
                <constraints nullable="false"/>
            </column>
            <column name="min_rating" type="numeric">
                <constraints nullable="true"/>
            </column>
            <column name="max_rating" type="numeric">
                <constraints nullable="true"/>
            </column>
            <column name="max_participants" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="display_order" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text" defaultValue="open">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE tournament_categories ADD CONSTRAINT ck_tournament_categories_type
                CHECK (category_type IN ('predefined', 'custom'));
            ALTER TABLE tournament_categories ADD CONSTRAINT ck_tournament_categories_status
                CHECK (status IN ('open', 'closed', 'completed'));
        </sql>
        <rollback>
            <dropTable tableName="tournament_categories"/>
        </rollback>
    </changeSet>

    <changeSet id="0008-tournament-categories-indexes" author="platform-enhancements">
        <createIndex tableName="tournament_categories" indexName="idx_tournament_categories_tournament_id">
            <column name="tournament_id"/>
        </createIndex>
    </changeSet>

    <!-- category_id on registrations/bracket matches: nullable, since a tournament may
         have zero categories (single flat bracket) — existing tournament-level
         min_rating/max_rating stay as-is for that case, categories are additive. -->
    <changeSet id="0009-add-category-id-to-tournament-registrations" author="platform-enhancements">
        <addColumn tableName="tournament_registrations">
            <column name="category_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_tournament_registrations_category" references="tournament_categories(id)"/>
            </column>
        </addColumn>
        <createIndex tableName="tournament_registrations" indexName="idx_tournament_registrations_category_id">
            <column name="category_id"/>
        </createIndex>
        <rollback>
            <dropColumn tableName="tournament_registrations" columnName="category_id"/>
        </rollback>
    </changeSet>

    <changeSet id="0010-add-category-id-to-bracket-matches" author="platform-enhancements">
        <addColumn tableName="bracket_matches">
            <column name="category_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_bracket_matches_category" references="tournament_categories(id)"/>
            </column>
        </addColumn>
        <createIndex tableName="bracket_matches" indexName="idx_bracket_matches_category_id">
            <column name="category_id"/>
        </createIndex>
        <rollback>
            <dropColumn tableName="bracket_matches" columnName="category_id"/>
        </rollback>
    </changeSet>

    <!-- RLS: tournament_category_templates is public reference data (same pattern as
         015-regions). tournament_categories mirrors tournaments_select_visible (008-security
         changeset 0029) exactly, joined one level further. platform_config gets RLS enabled
         with NO policies — nobody except the service-role client can read/write it; the
         SuperAdmin check itself always runs server-side via service-role. -->
    <changeSet id="0011-enable-rls" author="platform-enhancements">
        <sql>
            ALTER TABLE tournament_category_templates ENABLE ROW LEVEL SECURITY;
            ALTER TABLE tournament_categories ENABLE ROW LEVEL SECURITY;
            ALTER TABLE platform_config ENABLE ROW LEVEL SECURITY;
        </sql>
        <rollback>
            ALTER TABLE tournament_category_templates DISABLE ROW LEVEL SECURITY;
            ALTER TABLE tournament_categories DISABLE ROW LEVEL SECURITY;
            ALTER TABLE platform_config DISABLE ROW LEVEL SECURITY;
        </rollback>
    </changeSet>

    <changeSet id="0012-tournament-category-templates-policy" author="platform-enhancements">
        <sql>
            CREATE POLICY tournament_category_templates_select_all ON tournament_category_templates
                FOR SELECT USING (true);
        </sql>
        <rollback>
            DROP POLICY IF EXISTS tournament_category_templates_select_all ON tournament_category_templates;
        </rollback>
    </changeSet>

    <changeSet id="0013-tournament-categories-policy" author="platform-enhancements">
        <sql>
            CREATE POLICY tournament_categories_select_visible ON tournament_categories
                FOR SELECT
                USING (
                    tournament_id IN (
                        SELECT t.id FROM tournaments t
                        JOIN events e ON t.event_id = e.id
                        WHERE (e.visibility = 'public' AND e.status != 'draft')
                           OR e.created_by_player_id IN (SELECT id FROM player_profiles WHERE user_id = auth.uid())
                    )
                );
        </sql>
        <rollback>
            DROP POLICY IF EXISTS tournament_categories_select_visible ON tournament_categories;
        </rollback>
    </changeSet>

</databaseChangeLog>
